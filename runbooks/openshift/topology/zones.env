# Canonical zone topology for pg-multizone.
#
# Keep these values aligned across:
#   - Ceph CRUSH buckets (add-bucket / move)     → ZONES
#   - Ceph RBD pools                               → rbd_pool_for_zone()
#   - Ceph orch host labels (zone=<value>)         → ZONES
#   - OpenShift node labels                        → K8S_ZONE_LABEL + ZONES (§3a if inconsistent)
#   - StorageClass topologyConstrainedPools        → manifests/topology/storageclass-ceph-external-zone-nr.yaml
#   - ConfigMap ceph-csi-config + StorageClass     → CSI_CLUSTER_ID
#   - StatefulSet zone affinity (pg workload)    → manifests/pg/statefulset-external-rbd-nr.yaml
#
# If you change ZONES, update every row above and run:
#   ./topology/verify-alignment.sh          (OpenShift)
#   ./topology/verify-ceph-topology.sh      (Ceph admin node)
#
# Full reset (rollback): see External-Ceph-Cluster.md § Rollback and reset
#   CONFIRM=yes FULL=true ./06-cleanup-external-ceph.sh
#   ./topology/verify-k8s-clean.sh
#   CONFIRM=yes ./topology/reset-ceph-zones.sh --with-csi-user

K8S_ZONE_LABEL="topology.kubernetes.io/zone"

# Ceph-CSI node plugin --domainlabels (must match K8S_ZONE_LABEL; see External-Ceph-Cluster.md Step 2.2)
CSI_DOMAIN_LABELS="${K8S_ZONE_LABEL}"

# Logical Ceph-CSI cluster key — ConfigMap ceph-csi-config and StorageClass parameters.clusterID
# (not ceph fsid; see External-Ceph-Cluster.md Step 2.3 / §2.3a)
CSI_CLUSTER_ID="ceph-external"

ZONES=(zone-a zone-b zone-c)

# External Ceph pool naming: rbd-zone-a, rbd-zone-b, rbd-zone-c
rbd_pool_for_zone() {
  echo "rbd-${1}"
}

# Ceph CRUSH replicated rule name per zone: replicated-zone-a, …
crush_rule_for_zone() {
  echo "replicated-${1}"
}
